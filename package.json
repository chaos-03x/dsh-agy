{
  "name": "dsh-agy",
  "version": "0.4.6",
  "packageManager": "pnpm@11.28.3",
  "description": "Google Antigravity (agy) OAuth auth + model access plugin for DeepSeek Harness: multi-account pool, 429 rotation, device fingerprinting, CLI and web login.",
  "type": "module",
  "license": "MIT",
  "author": "chaos-03x <73626814+chaos-03x@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chaos-03x/dsh-agy.git"
  },
  "bin": {
    "dsh-agy": "bin/dsh-agy.js"
  },
  "main": "./lib/index.mjs",
  "types": "./lib/index.d.mts",
  "files": [
    "lib/",
    "bin/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "external": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json",
    "lint": "eslint src/client",
    "test": "vitest run",
    "test:watch": "vitest",
    "record:fixtures": "tsx scripts/record-fixture.ts",
    "e2e": "tsx scripts/e2e.ts",
    "debug:request": "tsx scripts/debug-request.ts",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build",
    "verify:tools": "tsx scripts/verify-tools.mts",
    "verify:blocks": "tsx scripts/verify-blocks.mts",
    "verify:contents-coalescing": "tsx scripts/verify-contents-coalescing.mts",
    "verify:claude-cap": "tsx scripts/verify-claude-cap.mts",
    "verify:proxy-routing": "tsx scripts/verify-proxy-routing.mts",
    "verify:version-freshness": "tsx scripts/verify-version-freshness.mts",
    "verify:official-identity": "tsx scripts/verify-official-identity.mts",
    "verify:metadata-acceptance": "tsx scripts/verify-metadata-acceptance.mts",
    "verify:claude-parts": "tsx scripts/verify-claude-parts.mts",
    "verify:thinking-config": "tsx scripts/verify-thinking-config.mts",
    "verify:thinking-levels": "tsx scripts/verify-thinking-levels.mts",
    "verify:dsh-llm-compat": "tsx scripts/verify-dsh-llm-compat.mts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.1 || ^0.2.0-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "dependencies": {
    "commander": "^14.0.0",
    "proper-lockfile": "^4.1.2",
    "undici": "^7.29.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-locale": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.1-rc.2",
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.7",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "react": "^18.2.0",
    "react-dom": "~18.3.1",
    "tsdown": "^0.22.14",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^3.0.0"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./web": {
      "types": "./lib/web/plugin.d.mts",
      "default": "./lib/web/plugin.mjs"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  }
}
